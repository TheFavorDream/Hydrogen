PROJECTS := ImGui Stb_image GLFW SimdJson Hydrogen Xenon SandBox

.PHONY: all clean help $(PROJECTS) Core Dependencies Misc

all: $(PROJECTS)

Core: Hydrogen Xenon

Dependencies: GLFW ImGui SimdJson Stb_image

Misc: SandBox

ImGui:
ifneq (,$(ImGui_config))
	@echo "==== Building ImGui ($(ImGui_config)) ===="
	@${MAKE} --no-print-directory -C Hydrogen/3rdParty/imgui -f Makefile config=$(ImGui_config)
endif

Stb_image:
ifneq (,$(Stb_image_config))
	@echo "==== Building Stb_image ($(Stb_image_config)) ===="
	@${MAKE} --no-print-directory -C Hydrogen/3rdParty/stb_image -f Makefile config=$(Stb_image_config)
endif

