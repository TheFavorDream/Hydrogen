endif

clean:
	@${MAKE} --no-print-directory -C Hydrogen/3rdParty/imgui -f Makefile clean
	@${MAKE} --no-print-directory -C Hydrogen/3rdParty/stb_image -f Makefile clean
	@${MAKE} --no-print-directory -C Hydrogen/3rdParty/glfw -f Makefile clean
	@${MAKE} --no-print-directory -C Hydrogen/3rdParty/SimdJson -f Makefile clean
	@${MAKE} --no-print-directory -C Hydrogen/Engine -f Makefile clean
