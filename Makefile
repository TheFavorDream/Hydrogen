ifneq (,$(GLFW_config))
	@echo "==== Building GLFW ($(GLFW_config)) ===="
	@${MAKE} --no-print-directory -C Hydrogen/3rdParty/glfw -f Makefile config=$(GLFW_config)
endif

SimdJson:
ifneq (,$(SimdJson_config))
	@echo "==== Building SimdJson ($(SimdJson_config)) ===="
	@${MAKE} --no-print-directory -C Hydrogen/3rdParty/SimdJson -f Makefile config=$(SimdJson_config)
endif

Hydrogen: GLFW ImGui Stb_image SimdJson Xenon
